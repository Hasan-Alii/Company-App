@model Employee

@{
    ViewData["Title"] = "Create Employee";
}

<h1>Create Employee</h1>
<br />
<br />
<form asp-action="Create" enctype="multipart/form-data">
   
    <partial name="EmployeePartialViews/CreateUpdateEmployeePartialView" model="Model" />
    <br />
    <input type="submit" value="Create Employee" class="btn btn-primary" />
    <a asp-action="Index" class="btn btn-outline-dark">Back To Employees List</a>
    

</form>

@section Validation{
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}