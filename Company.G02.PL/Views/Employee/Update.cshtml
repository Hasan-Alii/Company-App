 @model EmployeeViewModel

@{
    ViewData["Title"] = $"Update {Model.Name}";
}

<h1>Update @Model.Name</h1>

<br />
<br />

<form asp-action="Update" enctype="multipart/form-data">
    <partial name="EmployeePartialViews/CreateUpdateEmployeePartialView" model="Model" />

    <input hidden asp-for="ImageName"/>

    <br />
    <input type="submit" value="Update Employee" class="btn btn-success" />
    <a asp-action="Index" class="btn btn-outline-dark">Back To Employees List</a>
</form>

